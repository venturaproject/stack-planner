# Symfony values for the development container.
# DB_* values come from the root .env through compose.dev.yml.
APP_ENV=dev
DATABASE_URL="postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?serverVersion=18&charset=utf8"

APP_URL=http://localhost:8093
DEFAULT_URI=http://localhost:8093
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
COOKIE_SECURE=false
COOKIE_SAME_SITE=Strict
JWT_ACCESS_TTL_SECS=900
JWT_REFRESH_TTL_SECS=604800
TOTP_ISSUER=Planner

MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
LOCK_DSN=flock
MAILER_DSN=smtp://mailpit:1025
MAILER_FROM_ADDRESS=no-reply@example.com
