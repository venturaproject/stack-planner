{% extends 'emails/layout.html.twig' %}

{% block title %}Reset your password{% endblock %}

{% block body %}
    <h1>Reset your password</h1>
    <p>We received a request to reset the password for {{ userEmail }}. Open the secure link below to choose a new one.</p>
    <p><a href="{{ resetUrl }}">Reset your password</a></p>
    <p class="notice">This link expires in 1 hour and can only be used once. If you didn't request this, you can safely ignore this email.</p>
{% endblock %}
